# Talent Worth Environment Configuration Example

# API Configuration
PROJECT_NAME="Talent Worth API"
VERSION="1.0.0"
API_PREFIX="/api"
PORT=8000

# Security & Authentication
SECRET_KEY="replace-this-with-a-secure-random-32-byte-hex-string-for-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration (SQLite local, PostgreSQL for Supabase / Neon / Production)
DATABASE_URL="sqlite:///./talent_worth.db"
# DATABASE_URL="postgresql://user:password@ep-cool-db.us-east-1.aws.neon.tech/talentworth?sslmode=require"

# Data Engine Mode (Set to false when live job market API tokens are connected)
DEMO_MODE="true"

# Live Job API Integration Keys (Optional)
# USA_JOBS_API_KEY=""
# BLS_GOV_API_KEY=""
# ADZUNA_APP_ID=""
# ADZUNA_APP_KEY=""
